SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...service-role...
# Optional legacy fallback. New Supabase projects sign tokens with RS256/ES256
# and publish public keys at $SUPABASE_URL/auth/v1/.well-known/jwks.json, which
# the server discovers automatically. Only set this if you still issue HS256 tokens.
SUPABASE_JWT_SECRET=
FLASK_ENV=development
